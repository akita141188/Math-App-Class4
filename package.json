{
  "name": "math-app-class4",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @math-app/web --filter @math-app/api dev",
    "dev:web": "pnpm --filter @math-app/web dev",
    "dev:api": "pnpm --filter @math-app/api dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @math-app/web test",
    "test:api": "pnpm --filter @math-app/api test",
    "build": "pnpm -r build",
    "content:build-bank": "pnpm --filter @math-app/api content:build-bank",
    "content:validate": "pnpm --filter @math-app/api content:validate",
    "content:audit": "pnpm --filter @math-app/api content:audit",
    "content:duplicates": "pnpm --filter @math-app/api content:duplicates",
    "content:stats": "pnpm --filter @math-app/api content:stats",
    "content:review-export": "pnpm --filter @math-app/api content:review-export"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
